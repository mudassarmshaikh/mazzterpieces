{
  "expo": {
    "name": "MAZZ-terpieces",
    "updates": {
      "enabled": false
    },
    "slug": "mazz-terpieces",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#111318"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mazzterpieces.app"
    },
    "android": {
      "package": "com.mazzterpieces.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111318"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MAZZ-terpieces needs access to your photos to upload them.",
          "cameraPermission": "MAZZ-terpieces needs camera access to take photos."
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "mazzterpieces",
    "extra": {
      "eas": {
        "projectId": "f814e1aa-c3aa-4d87-b87e-daca869181a6"
      }
    }
  }
}
